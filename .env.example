# Local PostgreSQL settings used by docker compose.
# The backend defaults match these values. If you change them, also set
# OPEN_DEPO_DB_URL, OPEN_DEPO_DB_USERNAME and OPEN_DEPO_DB_PASSWORD.
POSTGRES_DB=opendepo
POSTGRES_USER=opendepo
POSTGRES_PASSWORD=opendepo
POSTGRES_PORT=5433

# Local Keycloak (development only). Do not use these defaults outside local development.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8180

# Backend OIDC and CORS settings
OPEN_DEPO_OIDC_ISSUER_URI=http://localhost:8180/realms/opendepo
OPEN_DEPO_WEB_ALLOWED_ORIGINS=http://localhost:3000
